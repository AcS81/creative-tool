generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model CreatorProfile {
  id          String          @id @default(uuid())
  type        String
  displayName String
  channelId   String?         @unique
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  analyses    VideoAnalysis[]
}

model VideoAnalysis {
  id               String          @id @default(uuid())
  creatorId        String
  youtubeVideoId   String
  title            String
  channelTitle     String?
  thumbnailUrl     String?
  durationSeconds  Int
  status           String
  failureReason    String?
  sessionId        String?
  passMode         String?
  analysisVersion  String?
  analysisConfigHash String?
  analysisConfigJson String?
  fingerprintSchemaVersion String?
  fingerprintSchemaHash String?
  analysisStage   String?
  stageStartedAt  DateTime?
  stageCompletedAt DateTime?
  leaseOwner      String?
  leaseExpiresAt  DateTime?
  leaseHeartbeatAt DateTime?
  ingestionJson   String?
  coreMetricsJson String?
  advancedMetricsJson String?
  idempotencyKey   String?         @unique
  attemptCount     Int             @default(0)
  maxAttempts      Int             @default(3)
  nextAttemptAt    DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  diagnosticsJson  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  creator          CreatorProfile  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  videoFingerprint VideoFingerprint?

  @@index([creatorId])
  @@index([youtubeVideoId])
  @@index([sessionId])
  @@index([status])
  @@index([nextAttemptAt])
  @@index([leaseExpiresAt])
  @@index([youtubeVideoId, analysisConfigHash, status])
}

model VideoFingerprint {
  id              String        @id @default(uuid())
  videoAnalysisId String        @unique
  fingerprint     String
  createdAt       DateTime      @default(now())
  videoAnalysis   VideoAnalysis @relation(fields: [videoAnalysisId], references: [id], onDelete: Cascade)
}

model User {
  id               String         @id @default(uuid())
  email            String?        @unique
  googleAccountId  String?        @unique
  displayName      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  youtubeAuthToken YoutubeAuthToken?
}

model YoutubeAuthToken {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  accessTokenEncrypted   String
  refreshTokenEncrypted  String
  scope                  String?
  tokenType              String?
  expiry                 DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
