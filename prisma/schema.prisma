generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model CreatorProfile {
  id String @id @default(cuid())
}

model VideoAnalysis {
  id String @id @default(cuid())
}

model VideoFingerprint {
  id String @id @default(cuid())
}
