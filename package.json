{
  "name": "creatorsight",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prisma:migrate": "CACHE_DIR=.prisma/cache prisma migrate dev",
    "prisma:studio": "CACHE_DIR=.prisma/cache prisma studio",
    "seed": "CACHE_DIR=.prisma/cache tsx prisma/seed.ts",
    "test": "vitest run",
    "probe:ingestion": "tsx scripts/probe-multimodal-ingestion.ts",
    "eval:golden": "tsx scripts/run-multimodal-golden.ts",
    "golden:multimodal": "tsx scripts/run-multimodal-golden.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "16.0.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.5.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.15"
  }
}
