{
  "name": "creatorsight",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "tsx scripts/dev-all.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prisma:migrate": "CACHE_DIR=.prisma/cache prisma migrate dev",
    "prisma:studio": "CACHE_DIR=.prisma/cache prisma studio",
    "seed": "CACHE_DIR=.prisma/cache tsx prisma/seed.ts",
    "reference:refresh": "tsx scripts/refresh-reference-library.ts",
    "reference:drift": "tsx scripts/reference-drift-check.ts",
    "test": "vitest run",
    "test:structure": "tsx scripts/test-structure-pass.ts",
    "test:pipeline": "tsx scripts/test-analysis-pipeline.ts",
    "test:pipeline:5min": "tsx scripts/test-analysis-pipeline.ts --video=test_short_5min",
    "test:pipeline:10min": "tsx scripts/test-analysis-pipeline.ts --video=test_medium_13min",
    "test:pipeline:20min": "tsx scripts/test-analysis-pipeline.ts --video=test_long_20min",
    "test:pipeline:40min": "tsx scripts/test-analysis-pipeline.ts --video=test_extended_40min",
    "test:pipeline:short": "tsx scripts/test-analysis-pipeline.ts --bucket=short",
    "test:pipeline:medium": "tsx scripts/test-analysis-pipeline.ts --bucket=medium",
    "test:pipeline:long": "tsx scripts/test-analysis-pipeline.ts --bucket=long",
    "probe:ingestion": "tsx scripts/probe-multimodal-ingestion.ts",
    "eval:golden": "tsx scripts/run-multimodal-golden.ts",
    "golden:multimodal": "tsx scripts/run-multimodal-golden.ts",
    "visual:check": "tsx scripts/visual-check.ts",
    "worker": "tsx scripts/analysis-worker.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "16.0.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.5.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.57.0",
    "prettier": "^3.7.4",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.15"
  }
}
